<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ComfortCross" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/parchment</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <style name="Theme.ComfortCross.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/parchment</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_cross</item>
        <item name="postSplashScreenTheme">@style/Theme.ComfortCross</item>
    </style>

</resources>
